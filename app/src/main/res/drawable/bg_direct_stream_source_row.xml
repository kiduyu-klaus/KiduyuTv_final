<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#33FFFFFF"/><stroke android:width="2dp" android:color="@color/kiduyu_red"/><corners android:radius="16dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#26FFFFFF"/><stroke android:width="3dp" android:color="@color/kiduyu_red"/><corners android:radius="16dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#2EE50914"/><stroke android:width="1dp" android:color="#80E50914"/><corners android:radius="16dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/direct_stream_surface_high"/><stroke android:width="1dp" android:color="@color/direct_stream_outline"/><corners android:radius="16dp"/></shape>
    </item>
</selector>
