<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/loadingArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <ImageView
            android:id="@+id/loadingBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/bufferingAnimation"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/buffering_animation"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_buffering" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wait_a_moment"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlayControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_direct_stream_top_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayerBack"
                style="@style/DirectStreamIconButtonFlat"
                android:contentDescription="@string/back"
                android:nextFocusDown="@id/btnPlayPause"
                app:icon="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRewind"
            style="@style/DirectStreamPillButton"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="20dp"
            android:contentDescription="@string/skip_back"
            android:nextFocusDown="@id/btnFill"
            android:nextFocusRight="@id/btnPlayPause"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="30"
            app:icon="@drawable/ic_replay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForward"
            style="@style/DirectStreamPillButton"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/skip_forward"
            android:nextFocusDown="@id/btnVolume"
            android:nextFocusLeft="@id/btnPlayPause"
            android:nextFocusUp="@id/btnPlayerBack"
            android:text="30"
            app:icon="@drawable/ic_forward" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@string/player_play_pause"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusDown="@id/btnFill"
            android:nextFocusLeft="@id/btnRewind"
            android:nextFocusRight="@id/btnForward"
            android:nextFocusUp="@id/btnPlayerBack"
            android:padding="0dp"
            app:backgroundTint="@color/direct_stream_primary"
            app:cornerRadius="36dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="@color/direct_stream_on_primary"
            app:rippleColor="@color/direct_stream_on_primary" />

        <FrameLayout
            android:id="@+id/skipOverlayContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="88dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipSegment"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@id/btnPlayPause"
                android:nextFocusUp="@id/btnPlayerBack"
                android:contentDescription="@string/skip_segment"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="20dp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/direct_stream_surface_high"
                app:cornerRadius="20dp"
                app:elevation="2dp"
                app:strokeColor="@color/direct_stream_outline"
                app:strokeWidth="1dp"
                tools:text="Skip Intro • 30s"
                xmlns:tools="http://schemas.android.com/tools" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAutoSkipCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:background="@drawable/bg_direct_stream_status"
            android:elevation="8dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone"
            xmlns:tools="http://schemas.android.com/tools"
            tools:text="Skipping Intro in 5..." />

        <LinearLayout
            android:id="@+id/videoBottomStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_direct_stream_bottom_scrim"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1">

                    <com.kiduyuk.klausk.kiduyutv.ui.player.directstream.SegmentedSeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:nextFocusUp="@id/btnPlayPause"
                        android:nextFocusDown="@id/btnFill"
                        android:max="1000"
                        android:progressTint="@color/direct_stream_primary"
                        android:thumbTint="@color/direct_stream_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviousEpisode"
                        style="@style/DirectStreamIconButton"
                        android:contentDescription="@string/player_previous_episode_cd"
                        android:visibility="gone"
                        app:icon="@drawable/ic_prev" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFill"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/player_fit"
                        android:nextFocusLeft="@id/btnVolume"
                        android:nextFocusRight="@id/btnPlayPause"
                        android:nextFocusUp="@id/btnRewind"
                        app:icon="@drawable/ic_fit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayerSubtitles"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/subdl_subtitles_cd"
                        android:nextFocusLeft="@id/btnFill"
                        android:nextFocusRight="@id/btnPlayerTracks"
                        android:nextFocusUp="@id/btnPlayerBack"
                        app:icon="@drawable/ic_subs" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayerTracks"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/track_settings_cd"
                        android:nextFocusLeft="@id/btnPlayPause"
                        android:nextFocusRight="@id/btnPlayerStreams"
                        android:nextFocusUp="@id/btnPlayerBack"
                        android:visibility="gone"
                        app:icon="@drawable/ic_tracks" />

                    <!-- Replaces Favorite from the supplied IPTV player. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayerStreams"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/stream_sources_cd"
                        android:nextFocusLeft="@id/btnPlayerTracks"
                        android:nextFocusRight="@id/btnVolume"
                        android:nextFocusUp="@id/btnPlayerBack"
                        android:visibility="gone"
                        app:icon="@drawable/ic_streams" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolume"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/player_volume"
                        android:nextFocusLeft="@id/btnPlayerStreams"
                        android:nextFocusRight="@id/btnFill"
                        android:nextFocusUp="@id/btnPlayerBack"
                        app:icon="@drawable/ic_vol" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextEpisode"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/player_next_episode_cd"
                        android:visibility="gone"
                        app:icon="@drawable/ic_next" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEpisodes"
                        style="@style/DirectStreamIconButton"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/player_episodes_cd"
                        android:nextFocusUp="@id/btnPlayerBack"
                        android:nextFocusDown="@id/btnPlayPause"
                        android:visibility="gone"
                        app:icon="@drawable/ic_episodes" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Scrim that fades in over the player while the panel is open.
         Keep it behind the panel so touch scrolls on the RecyclerView are not
         intercepted by the dimming overlay. -->
    <View
        android:id="@+id/episodesPanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- ============================================================== -->
    <!--  Episodes side panel                                           -->
    <!--  Sits on top of overlayControls. Toggled by btnEpisodes.       -->
    <!--  translationX is animated by DirectStreamActivity.             -->
    <!-- ============================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/episodesPanelContainer"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:translationX="-360dp"
        android:visibility="gone"
        android:nextFocusRight="@id/btnEpisodes"
        app:cardBackgroundColor="@color/direct_stream_surface_high"
        app:cardCornerRadius="28dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/direct_stream_outline"
        app:strokeWidth="1dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/direct_stream_surface_high">

            <!-- Panel header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvEpisodesPanelHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    tools:text="Season 1 — 13 episodes"
                    xmlns:tools="http://schemas.android.com/tools" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseEpisodesPanel"
                    style="@style/DirectStreamIconButtonFlat"
                    android:contentDescription="@string/close"
                    app:icon="@drawable/ic_close" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/direct_stream_outline" />

            <!-- Status row shown while loading or on error -->
            <TextView
                android:id="@+id/tvEpisodesPanelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                xmlns:tools="http://schemas.android.com/tools"
                tools:text="@string/episode_panel_loading" />

            <!-- Episode list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Kept outside overlayControls so buffering remains visible after
         the playback controls automatically hide. -->
    <com.kiduyuk.klausk.kiduyutv.ui.player.directstream.AnimatedSemiCircleProgressView
        android:id="@+id/providerFetchProgress"
        android:layout_width="260dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:contentDescription="@string/streams_loading"
        android:elevation="14dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_direct_stream_status"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/streams_loading"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
