<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_direct_stream_dialog"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_direct_stream_source_icon">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_direct_stream_cloud" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stream_choose"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStreamCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/stream_choose_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStreamFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_direct_stream_track_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@id/listStreams"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/stream_filter_all"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStreamFilterEnglish"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_direct_stream_track_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@id/listStreams"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/stream_filter_english"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStreamFilterHindi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_direct_stream_track_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@id/listStreams"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/stream_filter_hindi"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnStreamLayoutToggle"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_direct_stream_track_tab"
            android:contentDescription="@string/stream_layout_grid"
            android:focusable="true"
            android:nextFocusDown="@id/listStreams"
            android:padding="8dp"
            android:src="@drawable/ic_layout_grid"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <GridView
        android:id="@+id/listStreams"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="14dp"
        android:cacheColorHint="@android:color/transparent"
        android:clickable="true"
        android:columnWidth="280dp"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:horizontalSpacing="10dp"
        android:nextFocusDown="@id/btnCloseStreams"
        android:nextFocusUp="@id/btnStreamFilterEnglish"
        android:numColumns="1"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp"
        android:listSelector="@drawable/bg_direct_stream_source_focus" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/direct_stream_outline" />

    <TextView
        android:id="@+id/btnCloseStreams"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:background="@drawable/direct_stream_back_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusUp="@id/listStreams"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/track_close"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
