<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KiduyuTv" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/banner</item>
        <item name="postSplashScreenTheme">@style/Theme.KiduyuTv</item>
    </style>

    <style name="Theme.KiduyuTv.Auth" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.KiduyuTv.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/kiduyu_red</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_dark</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.KiduyuTv.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/kiduyu_red</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_dark</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:hardwareAccelerated">true</item>
    </style>

    <style name="Theme.KiduyuTv.DirectStreamPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/kiduyu_red</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/kiduyu_red</item>
        <item name="colorSurface">@color/direct_stream_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/direct_stream_surface_high</item>
        <item name="colorOutline">@color/direct_stream_outline</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:hardwareAccelerated">true</item>
    </style>

    <style name="DirectStreamTrackTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_direct_stream_track_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DirectStreamControlButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/direct_stream_back_btn_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="DirectStreamRoundControlButton" parent="DirectStreamControlButton">
        <item name="android:background">@drawable/bg_direct_stream_round_control</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="DirectStreamPlayControlButton" parent="DirectStreamControlButton">
        <item name="android:background">@drawable/bg_direct_stream_play_control</item>
        <item name="android:elevation">12dp</item>
    </style>

    <style name="Theme.NoTitleBar.Fullscreen" parent="@android:style/Theme.NoTitleBar.Fullscreen" />
    <style name="Theme.Translucent.NoTitleBar.Fullscreen" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
    <style name="DirectStreamIconButton" parent="Widget.Material3.Button.IconButton">
    <item name="android:layout_width">40dp</item>
    <item name="android:layout_height">40dp</item>
    <item name="android:insetLeft">0dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetRight">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:padding">0dp</item>
    <item name="backgroundTint">@color/direct_stream_surface</item>
    <item name="cornerRadius">20dp</item>
    <item name="iconGravity">textStart</item>
    <item name="iconPadding">0dp</item>
    <item name="iconSize">20dp</item>
    <item name="iconTint">#FFFFFF</item>
    <item name="rippleColor">#33FFFFFF</item>
</style>

    <!-- Small flat icon button: top-bar back, panel close -->
    <style name="DirectStreamIconButtonFlat" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/direct_stream_surface</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="rippleColor">@color/direct_stream_outline</item>
    </style>

    <!-- Bottom control-strip icon buttons: Fit, Subs, Tracks, Streams, Vol, Prev/Next, Episodes -->
    
    <!-- Rewind/forward pill buttons: icon + "30" label -->
    <style name="DirectStreamPillButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/direct_stream_surface_high</item>
        <item name="cornerRadius">26dp</item>
        <item name="elevation">2dp</item>
        <item name="strokeColor">@color/direct_stream_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="rippleColor">@color/direct_stream_outline</item>
    </style>






    <style name="Theme.Translucent.NoTitleBar" parent="@android:style/Theme.Translucent.NoTitleBar" />
</resources>

